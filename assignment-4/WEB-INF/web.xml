<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor for the JSP electricity bill calculator.

    There are no servlet classes to register - the whole application is JSP -
    so this file only names the welcome page and the session timeout. Tomcat
    already treats index.jsp as a welcome file, so the app also runs if this
    file is deleted.

    This descriptor targets Java EE 8 (Tomcat 9, GlassFish 5). On Tomcat 10+ or
    GlassFish 6+ replace the two xmlns/schema URLs with the Jakarta ones:

        xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                            https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
        version="5.0"

    The .jsp files themselves need no change on either server, because they
    import nothing from javax.servlet.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Electricity Bill Calculator</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
